OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CODEBASE_DATA_DIR=./data
GITHUB_TOKEN=
# Separate repository-scoped token with Issues: write, Pull requests: write, and Contents: write access; never expose to the browser.
GITHUB_WRITE_TOKEN=
MAX_REPO_FILES=1200
MAX_FILE_BYTES=150000
MAX_REPO_BYTES=20000000
MAX_CHUNK_LINES=120
MAX_CHUNKS_PER_REPO=8000
MIN_LEXICAL_COVERAGE=0.2
MIN_COSINE_SIMILARITY=0.25
SESSION_TTL_DAYS=14
SESSION_COOKIE_SECURE=false
REPOSITORY_SYNC_INTERVAL_MINUTES=60
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
